#include <stdio.h>

int main()
{
    int product, customer, orderNumber;
    float orderAmount, distance;
    float discountRate, discountAmount, finalAmount;
    float deliveryCharges, priorityCharges, totalAmount;

    printf("E-Commerce Order Processing System \n");

    printf("\nSelect Product Category:\n");
    printf("1. Electronics\n");
    printf("2. Clothing\n");
    printf("3. Books\n");
    printf("4. Household\n");

    printf("\nEnter product category: ");
    scanf("%d", &product);

    printf("\nSelect Customer Category:\n");
    printf("1. Regular\n");
    printf("2. Premium\n");
    printf("3. Corporate\n");

    printf("\nEnter customer category: ");
    scanf("%d", &customer);

    printf("\nEnter order amount: ");
    scanf("%f", &orderAmount);

    printf("Enter delivery distance (km): ");
    scanf("%f", &distance);

    printf("Enter order number: ");
    scanf("%d", &orderNumber);

    switch (product)
    {
        case 1:
            switch (customer)
            {
                case 1:
                    discountRate = 5;
                    break;

                case 2:
                    discountRate = 10;
                    break;

                case 3:
                    discountRate = 15;
                    break;

                default:
                    printf("Invalid customer category!\n");
                    return 0;
            }
            break;

        case 2:
            switch (customer)
            {
                case 1:
                    discountRate = 10;
                    break;

                case 2:
                    discountRate = 15;
                    break;

                case 3:
                    discountRate = 20;
                    break;

                default:
                    printf("Invalid customer category!\n");
                    return 0;
            }
            break;

        case 3:
            switch (customer)
            {
                case 1:
                    discountRate = 8;
                    break;

                case 2:
                    discountRate = 12;
                    break;

                case 3:
                    discountRate = 18;
                    break;

                default:
                    printf("Invalid customer category!\n");
                    return 0;
            }
            break;

        case 4:
            switch (customer)
            {
                case 1:
                    discountRate = 7;
                    break;

                case 2:
                    discountRate = 14;
                    break;

                case 3:
                    discountRate = 20;
                    break;

                default:
                    printf("Invalid customer category!\n");
                    return 0;
            }
            break;

        default:
            printf("Invalid product category!\n");
            return 0;
    }

    discountAmount = orderAmount * discountRate / 100;
    finalAmount = orderAmount - discountAmount;

    if (finalAmount >= 5000 || customer == 2 || customer == 3)
    {
        deliveryCharges = 0;
    }
    else
    {
        deliveryCharges = distance * 50;
    }

    if ((customer == 2 || customer == 3) && orderAmount >= 10000)
    {
        priorityCharges = 500;
    }
    else
    {
        priorityCharges = 0;
    }

    totalAmount = finalAmount + deliveryCharges + priorityCharges;

    printf("\nFINAL ORDER REPORT \n");

    if (product == 1)
        printf("Product Category: Electronics\n");
    else if (product == 2)
        printf("Product Category: Clothing\n");
    else if (product == 3)
        printf("Product Category: Books\n");
    else
        printf("Product Category: Household\n");

    if (customer == 1)
        printf("Customer Category: Regular\n");
    else if (customer == 2)
        printf("Customer Category: Premium\n");
    else
        printf("Customer Category: Corporate\n");

    printf("Original Order Amount: Rs. %.2f\n", orderAmount);
    printf("Discount: %.2f%%\n", discountRate);
    printf("Discount Amount: Rs. %.2f\n", discountAmount);
    printf("Final Payable Amount: Rs. %.2f\n", finalAmount);
    printf("Delivery Distance: %.2f km\n", distance);

    printf("Shipping Status: %s\n",
           (finalAmount >= 5000 || customer == 2 || customer == 3)
           ? "Free Shipping"
           : "Shipping Charges Apply");

    printf("Delivery Charges: Rs. %.2f\n", deliveryCharges);

    printf("Priority Delivery: %s\n",
           ((customer == 2 || customer == 3) && orderAmount >= 10000)
           ? "Yes"
           : "No");

    printf("Priority Charges: Rs. %.2f\n", priorityCharges);

    if (orderNumber % 4 == 0)
        printf("Processing Group: A\n");
    else if (orderNumber % 4 == 1)
        printf("Processing Group: B\n");
    else if (orderNumber % 4 == 2)
        printf("Processing Group: C\n");
    else
        printf("Processing Group: D\n");

    printf("Total Amount Payable: Rs. %.2f\n", totalAmount);

    return 0;
}