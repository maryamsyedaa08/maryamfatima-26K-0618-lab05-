#include <stdio.h>

int main()
{
    int status = 0;
    int operation, device, mode;
    int flag;

    printf(" Smart Home Security Controller \n");

    printf("\nSelect Operation:\n");
    printf("1. Activate Device\n");
    printf("2. Deactivate Device\n");
    printf("3. Check Device Status\n");
    printf("4. Toggle Device\n");

    printf("\nEnter operation: ");
    scanf("%d", &operation);

    switch (operation)
    {
        case 1:
            printf("\nSelect Device:\n");
            printf("1. Main Door Lock\n");
            printf("2. Alarm System\n");
            printf("3. CCTV Camera\n");
            printf("4. Motion Sensor\n");
            printf("Enter device: ");
            scanf("%d", &device);

            switch (device)
            {
                case 1:
                    status = status | (1 << 0);
                    break;

                case 2:
                    status = status | (1 << 1);
                    break;

                case 3:
                    status = status | (1 << 2);
                    break;

                case 4:
                    status = status | (1 << 3);
                    break;

                default:
                    printf("Invalid device!\n");
            }
            break;

        case 2:
            printf("\nSelect Device:\n");
            printf("1. Main Door Lock\n");
            printf("2. Alarm System\n");
            printf("3. CCTV Camera\n");
            printf("4. Motion Sensor\n");
            printf("Enter device: ");
            scanf("%d", &device);

            switch (device)
            {
                case 1:
                    status = status & ~(1 << 0);
                    break;

                case 2:
                    status = status & ~(1 << 1);
                    break;

                case 3:
                    status = status & ~(1 << 2);
                    break;

                case 4:
                    status = status & ~(1 << 3);
                    break;

                default:
                    printf("Invalid device!\n");
            }
            break;

        case 3:
            printf("\nSelect Device:\n");
            printf("1. Main Door Lock\n");
            printf("2. Alarm System\n");
            printf("3. CCTV Camera\n");
            printf("4. Motion Sensor\n");
            printf("Enter device: ");
            scanf("%d", &device);

            switch (device)
            {
                case 1:
                    flag = status & (1 << 0);
                    printf("Main Door Lock: %s\n",
                           flag ? "Active" : "Inactive");
                    break;

                case 2:
                    flag = status & (1 << 1);
                    printf("Alarm System: %s\n",
                           flag ? "Active" : "Inactive");
                    break;

                case 3:
                    flag = status & (1 << 2);
                    printf("CCTV Camera: %s\n",
                           flag ? "Active" : "Inactive");
                    break;

                case 4:
                    flag = status & (1 << 3);
                    printf("Motion Sensor: %s\n",
                           flag ? "Active" : "Inactive");
                    break;

                default:
                    printf("Invalid device!\n");
            }
            break;

        case 4:
            printf("\nSelect Device:\n");
            printf("1. Main Door Lock\n");
            printf("2. Alarm System\n");
            printf("3. CCTV Camera\n");
            printf("4. Motion Sensor\n");
            printf("Enter device: ");
            scanf("%d", &device);

            switch (device)
            {
                case 1:
                    status = status ^ (1 << 0);
                    break;

                case 2:
                    status = status ^ (1 << 1);
                    break;

                case 3:
                    status = status ^ (1 << 2);
                    break;

                case 4:
                    status = status ^ (1 << 3);
                    break;

                default:
                    printf("Invalid device!\n");
            }
            break;

        default:
            printf("Invalid operation!\n");
            return 0;
    }

    printf("\nSecurity Mode\n");
    printf("1. Home Mode\n");
    printf("2. Away Mode\n");
    printf("3. Night Mode\n");

    printf("Enter mode: ");
    scanf("%d", &mode);

    switch (mode)
    {
        case 1:
            status = status | (1 << 0) | (1 << 2);
            printf("Home Mode activated.\n");
            break;

        case 2:
            status = status | (1 << 0) | (1 << 1) |
                     (1 << 2) | (1 << 3);
            printf("Away Mode activated.\n");
            break;

        case 3:
            status = status | (1 << 0) | (1 << 1) |
                     (1 << 3);
            printf("Night Mode activated.\n");
            break;

        default:
            printf("Invalid mode!\n");
    }

    printf("\n DEVICE STATUS \n");

    printf("Main Door Lock [1]: %s\n",
           (status & (1 << 0)) ? "Active" : "Inactive");

    printf("Alarm System   [2]: %s\n",
           (status & (1 << 1)) ? "Active" : "Inactive");

    printf("CCTV Camera    [4]: %s\n",
           (status & (1 << 2)) ? "Active" : "Inactive");

    printf("Motion Sensor  [8]: %s\n",
           (status & (1 << 3)) ? "Active" : "Inactive");

    printf("\nBinary Status: %d%d%d%d\n",
           (status & (1 << 3)) ? 1 : 0,
           (status & (1 << 2)) ? 1 : 0,
           (status & (1 << 1)) ? 1 : 0,
           (status & (1 << 0)) ? 1 : 0);

    if ((status & (1 << 0)) &&
        (status & (1 << 1)) &&
        (status & (1 << 2)) &&
        (status & (1 << 3)))
    {
        printf("Security System: Fully Armed\n");
    }
    else
    {
        printf("Security System: Not Fully Armed\n");
    }

    return 0;
}